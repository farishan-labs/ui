{
  "color": {
    "bg": {
      "default": { "$type": "color", "$value": "#ffffff" },
      "muted": { "$type": "color", "$value": "#f4f4f5" },
      "inverse": { "$type": "color", "$value": "#09090b" }
    },
    "fg": {
      "default": { "$type": "color", "$value": "#09090b" },
      "muted": { "$type": "color", "$value": "#71717a" },
      "inverse": { "$type": "color", "$value": "#fafafa" }
    },
    "border": {
      "default": { "$type": "color", "$value": "#e4e4e7" },
      "strong": { "$type": "color", "$value": "#a1a1aa" }
    },
    "accent": {
      "default": { "$type": "color", "$value": "#2563eb" },
      "hover": { "$type": "color", "$value": "#1d4ed8" },
      "fg": { "$type": "color", "$value": "#ffffff" }
    },
    "danger": {
      "default": { "$type": "color", "$value": "#dc2626" },
      "fg": { "$type": "color", "$value": "#ffffff" }
    },
    "success": {
      "default": { "$type": "color", "$value": "#16a34a" },
      "fg": { "$type": "color", "$value": "#ffffff" }
    }
  },
  "space": {
    "0": { "$type": "dimension", "$value": "0" },
    "1": { "$type": "dimension", "$value": "0.25rem" },
    "2": { "$type": "dimension", "$value": "0.5rem" },
    "3": { "$type": "dimension", "$value": "0.75rem" },
    "4": { "$type": "dimension", "$value": "1rem" },
    "6": { "$type": "dimension", "$value": "1.5rem" },
    "8": { "$type": "dimension", "$value": "2rem" }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": "0.25rem" },
    "md": { "$type": "dimension", "$value": "0.375rem" },
    "lg": { "$type": "dimension", "$value": "0.5rem" },
    "full": { "$type": "dimension", "$value": "9999px" }
  },
  "font": {
    "family": {
      "sans": {
        "$type": "fontFamily",
        "$value": "ui-sans-serif, system-ui, -apple-system, sans-serif"
      },
      "mono": { "$type": "fontFamily", "$value": "ui-monospace, SFMono-Regular, Menlo, monospace" }
    },
    "size": {
      "xs": { "$type": "dimension", "$value": "0.75rem" },
      "sm": { "$type": "dimension", "$value": "0.875rem" },
      "md": { "$type": "dimension", "$value": "1rem" },
      "lg": { "$type": "dimension", "$value": "1.125rem" },
      "xl": { "$type": "dimension", "$value": "1.25rem" }
    }
  },
  "motion": {
    "duration": {
      "fast": { "$type": "duration", "$value": "100ms" },
      "normal": { "$type": "duration", "$value": "200ms" },
      "slow": { "$type": "duration", "$value": "300ms" }
    }
  },
  "shadow": {
    "sm": { "$type": "shadow", "$value": "0 1px 2px 0 rgb(0 0 0 / 0.05)" },
    "md": { "$type": "shadow", "$value": "0 4px 6px -1px rgb(0 0 0 / 0.1)" }
  }
}
